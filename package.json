{
  "name": "windletter-launcher",
  "version": "0.60.6",
  "private": true,
  "description": "风信启动器 - 风有信，月无边。一个受 PCL2 启发的 Minecraft 启动器",
  "main": "./out/main/index.js",
  "author": "Windletter",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:download": "vite build --config scripts/download-smoke-test/vite.config.ts && node scripts/download-smoke-test/.tmp/dist/test.cjs",
    "aliases:mcmod": "node scripts/mcmod-alias-import/index.mjs",
    "update:manifest": "node scripts/make-update-manifest.mjs",
    "dist": "electron-vite build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.windletter.launcher",
    "productName": "风信启动器",
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Windletter-Launcher-${version}-setup.${ext}"
    },
    "extraResources": [
      {
        "from": "build/playtime-watch.exe",
        "to": "playtime-watch.exe"
      }
    ]
  },
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "adm-zip": "^0.6.1",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.61.0",
    "pinyin-pro": "^3.29.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "undici": "^7.30.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
